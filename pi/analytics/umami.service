# /etc/systemd/system/umami.service - memory-limited Umami 3.3.1 using external PostgreSQL.
[Unit]
Description=Umami analytics (external PostgreSQL, memory limited)
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Restart=always
RestartSec=10
TimeoutStartSec=0
ExecStartPre=/usr/bin/test -s /srv/ops/umami.env
ExecStartPre=-/usr/bin/docker rm -f umami
ExecStartPre=-/usr/bin/docker pull ghcr.io/umami-software/umami:3.3.1@sha256:a1af44521dd779aad7d2c32cee1a92c407c95d56703fb5d79b19eeeaea6aec3b
ExecStart=/usr/bin/docker run --rm --name umami --init --memory=320m --memory-reservation=192m --memory-swap=384m --cpus=0.75 --pids-limit=256 --security-opt no-new-privileges --log-driver local --log-opt max-size=10m --log-opt max-file=3 -p 127.0.0.1:3001:3000 --env-file /srv/ops/umami.env --health-cmd="curl -fsS http://127.0.0.1:3000/api/heartbeat || exit 1" --health-start-period=120s --health-interval=30s --health-timeout=5s --health-retries=5 ghcr.io/umami-software/umami:3.3.1@sha256:a1af44521dd779aad7d2c32cee1a92c407c95d56703fb5d79b19eeeaea6aec3b
ExecStop=/usr/bin/docker stop umami

[Install]
WantedBy=multi-user.target
