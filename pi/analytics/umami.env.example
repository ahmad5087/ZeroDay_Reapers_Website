# Copy to /srv/ops/umami.env, fill it, then chown root:zdrops and chmod 640.
# Use a DEDICATED external PostgreSQL database. Do not point Umami at the production portal database.
# Keep these values unquoted: this file is consumed by `docker run --env-file`.
# With Neon, DATABASE_URL is the pooled URL and DIRECT_DATABASE_URL is the non-pooler URL used for migrations/dumps.
DATABASE_URL=postgresql://umami_user:CHANGE_ME@ep-example-pooler.ap-southeast-1.aws.neon.tech/umami?sslmode=require
DIRECT_DATABASE_URL=postgresql://umami_user:CHANGE_ME@ep-example.ap-southeast-1.aws.neon.tech/umami?sslmode=require

# Generate both independently with: openssl rand -hex 32
APP_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_HEX_STRING
TWO_FACTOR_ENCRYPTION_KEY=CHANGE_ME_TO_A_DIFFERENT_64_CHARACTER_HEX_STRING

# Respect the original visitor IP forwarded by the existing Cloudflare Tunnel and disable vendor telemetry.
CLIENT_IP_HEADER=cf-connecting-ip
DISABLE_TELEMETRY=1
