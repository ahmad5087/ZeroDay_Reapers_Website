# Copy to /srv/ops/umami.env, fill it, then chown root:zdrops and chmod 640.
# Use a DEDICATED external PostgreSQL database. Do not point Umami at the production portal database.
DATABASE_URL=postgresql://umami_user:CHANGE_ME@db.example.com:5432/umami?sslmode=require

# Generate both independently with: openssl rand -hex 32
APP_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHARACTER_HEX_STRING
TWO_FACTOR_ENCRYPTION_KEY=CHANGE_ME_TO_A_DIFFERENT_64_CHARACTER_HEX_STRING
