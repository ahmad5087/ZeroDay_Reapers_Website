# Per-service Discord routing. Copy to /srv/ops/notifications.env, keep zdrops:zdrops mode 600,
# and never commit real webhook URLs. The legacy DISCORD_WEBHOOK in backup.env remains a
# temporary fallback while migrating.

# Gatus endpoint alerts (also copy these keys into /srv/ops/gatus/gatus.env for Docker).
export DISCORD_GATUS_WEBSITE_WEBHOOK='CHANGE_ME'
export DISCORD_GATUS_PORTAL_WEBHOOK='CHANGE_ME'
export DISCORD_GATUS_LOGIN_WEBHOOK='CHANGE_ME'
export DISCORD_GATUS_APP_HEALTH_WEBHOOK='CHANGE_ME'
export DISCORD_GATUS_SUPABASE_WEBHOOK='CHANGE_ME'
export DISCORD_GATUS_R2_WEBHOOK='CHANGE_ME'

# Pi backup and watchdog jobs.
export DISCORD_BACKUP_WEBHOOK='CHANGE_ME'
export DISCORD_CONFIG_BACKUP_WEBHOOK='CHANGE_ME'
export DISCORD_OFFSITE_COPY_WEBHOOK='CHANGE_ME'
export DISCORD_RESTORE_DRILL_WEBHOOK='CHANGE_ME'
export DISCORD_GUARDIAN_WEBHOOK='CHANGE_ME'

# Scheduled operations reports.
export DISCORD_CAPACITY_WEBHOOK='CHANGE_ME'
export DISCORD_WEEKLY_OPS_WEBHOOK='CHANGE_ME'
export DISCORD_WEEKLY_UMAMI_WEBHOOK='CHANGE_ME'
export DISCORD_MONTHLY_WEBHOOK='CHANGE_ME'
