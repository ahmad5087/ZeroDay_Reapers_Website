# Copy to /srv/ops/reports.env, then chown root:root and chmod 600.
# Leave this empty while Umami has exactly one active website. If more websites are added,
# set the UUID for zerodayreapers.me here; no Umami login password is needed.
export UMAMI_WEBSITE_ID=''
export UMAMI_REPORT_TIMEZONE=Asia/Karachi

# Provider-plan capacity ceilings (decimal bytes, matching the provider dashboards).
export B2_LIMIT_BYTES=10000000000
export NEON_LIMIT_BYTES=500000000
export SUPABASE_DATABASE_LIMIT_BYTES=500000000
export SUPABASE_STORAGE_LIMIT_BYTES=1000000000
export SUPABASE_MAU_LIMIT=50000
export CLOUDFLARE_R2_LIMIT_BYTES=10000000000
export REPORT_CAPACITY_WARN_PERCENT=80
export REPORT_CAPACITY_CRITICAL_PERCENT=90
