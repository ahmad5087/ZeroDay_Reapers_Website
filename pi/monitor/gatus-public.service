# /etc/systemd/system/gatus-public.service - sanitized public Gatus on loopback port 8081.
[Unit]
Description=Sanitized public Gatus status page
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=0
ExecStartPre=-/usr/bin/docker rm -f gatus-public
ExecStartPre=-/usr/bin/docker pull twinproduction/gatus:v5.36.0
ExecStart=/usr/bin/docker run --rm --name gatus-public --memory=128m --memory-swap=160m --pids-limit=128 --log-driver local --log-opt max-size=10m --log-opt max-file=3 -p 127.0.0.1:8081:8080 --env-file /srv/ops/gatus-public/gatus-public.env -e GATUS_CONFIG_PATH=/config/gatus.yaml -v /srv/ops/gatus-public:/config twinproduction/gatus:v5.36.0
ExecStop=/usr/bin/docker stop gatus-public

[Install]
WantedBy=multi-user.target
