[Unit]
Description=ZDR Tailscale health monitor
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/srv/ops/tailscale-health.env
ExecStart=/srv/ops/tailscale-health.sh
TimeoutStartSec=45s
Nice=15
IOSchedulingClass=idle
MemoryHigh=48M
MemoryMax=96M
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true
StateDirectory=zdr-tailscale-health
ReadWritePaths=/var/lib/zdr-tailscale-health /var/lib/zdr-discord-queue
