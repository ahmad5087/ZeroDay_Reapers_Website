[Unit]
Description=ZDR weekly private Gatus SLO report
After=network-online.target gatus.service
Requires=gatus.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/srv/ops/gatus-slo-report.sh
TimeoutStartSec=5m
Nice=15
IOSchedulingClass=idle
MemoryHigh=64M
MemoryMax=128M
NoNewPrivileges=true
ProtectHome=true
ProtectSystem=strict
PrivateTmp=true
ReadWritePaths=/var/lib/zdr-discord-queue
