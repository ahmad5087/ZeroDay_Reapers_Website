# Copy to /srv/ops/offsite.env, fill it, then chown zdrops:zdrops and chmod 600.
# Use an rclone remote for a provider/account independent from the portal's Cloudflare account.
# Example after creating an rclone remote named b2-zdr:
export RESTIC_OFFSITE_REPOSITORY='rclone:b2-zdr:zdr-offsite-restic'

# Use a separate strong password and store it off the Pi with the primary RESTIC_PASSWORD.
export RESTIC_OFFSITE_PASSWORD='CHANGE-ME-to-a-second-long-random-string'
