# /etc/systemd/system/cloudflared.service — Cloudflare Tunnel that publishes the gatus dashboard as a
# public status page (e.g. https://status.zerodayreapers.me) WITHOUT opening any inbound port on your
# router. cloudflared dials OUT to Cloudflare (no port-forwarding, no dynamic DNS), and --network host
# lets it reach sanitized public Gatus at 127.0.0.1:8081. The token is in cloudflared.env (chmod 600).
# Create the tunnel + the status.<domain> -> http://localhost:8081 route in the Cloudflare Zero Trust
# dashboard first (see pi/tunnel/README.md), then paste its token into cloudflared.env.
[Unit]
Description=Cloudflare Tunnel (public gatus status page), containerized
After=docker.service network-online.target gatus-public.service
Requires=docker.service
Wants=network-online.target

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=0
EnvironmentFile=/srv/ops/cloudflared.env
ExecStartPre=-/usr/bin/docker rm -f cloudflared
ExecStartPre=-/usr/bin/docker pull cloudflare/cloudflared:latest
ExecStart=/usr/bin/docker run --rm --name cloudflared --network host --log-driver local --log-opt max-size=10m --log-opt max-file=3 cloudflare/cloudflared:latest tunnel --no-autoupdate run --token ${TUNNEL_TOKEN}
ExecStop=/usr/bin/docker stop cloudflared

[Install]
WantedBy=multi-user.target
