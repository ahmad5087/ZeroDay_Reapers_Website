# cloudflared.env — copy to /srv/ops/cloudflared.env (chmod 600, owner root). NOT committed (gitignored).
# The tunnel TOKEN from: Cloudflare Zero Trust -> Networks -> Tunnels -> (your tunnel) -> Install connector.
# It's a long "eyJ..." string; treat it as a secret (it authorizes the tunnel).
TUNNEL_TOKEN=paste-your-cloudflare-tunnel-token-here
