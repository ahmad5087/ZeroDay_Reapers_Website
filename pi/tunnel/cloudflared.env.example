# cloudflared.env - copy to /srv/ops/cloudflared.env (chmod 600, owner root). NOT committed (gitignored).
# The tunnel token comes from Cloudflare Zero Trust -> Networks -> Tunnels -> your tunnel -> Add replica.
# Treat it as a secret: anyone with this value can run a connector for the tunnel.
TUNNEL_TOKEN=paste-your-cloudflare-tunnel-token-here
