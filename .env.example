# Supabase — create a free project at supabase.com → Settings → API
# Both values are safe to expose in the browser (anon key is designed for that).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY

# Cloudflare R2 — task PDFs + resumes (server-only secrets, NOT public). See R2_SETUP.md
R2_ACCOUNT_ID=your_account_id
R2_ACCESS_KEY_ID=your_access_key_id
R2_SECRET_ACCESS_KEY=your_secret_access_key
R2_BUCKET=zdr-portal

# Resend — email notifications (free tier). See EMAIL_SETUP.md. Server-only.
RESEND_API_KEY=re_your_key_here
RESEND_FROM=ZeroDay Reapers <onboarding@resend.dev>

# Discord auto-join at signup (optional). When NEXT_PUBLIC_DISCORD_CLIENT_ID is set, the
# signup form shows "Connect Discord" (OAuth auto-join). Leave unset to fall back to the
# honor-mode invite + checkbox. See DISCORD_OAUTH_SETUP.md.
NEXT_PUBLIC_DISCORD_CLIENT_ID=            # public: Discord application (client) id
DISCORD_CLIENT_SECRET=                    # server-only
DISCORD_BOT_TOKEN=                        # server-only; bot must be in the server w/ Create Invite perm
DISCORD_GUILD_ID=                         # numeric server id (NOT the invite code)
# NEXT_PUBLIC_DISCORD_INVITE=https://discord.com/invite/JATEvx9FED  # honor-mode fallback link

# Supabase service role — server-only, NEVER expose. Used by the deadline-reminder cron to
# read tasks/students across RLS. Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# Cron auth — any long random string. Vercel Cron sends it as `Authorization: Bearer <value>`.
# The /api/cron/* route rejects requests without it.
CRON_SECRET=

# Portfolio proxy target (unrelated to the portal) — set on the MAIN Vercel project
PORTFOLIO_URL=https://your-portfolio-deployment.vercel.app
